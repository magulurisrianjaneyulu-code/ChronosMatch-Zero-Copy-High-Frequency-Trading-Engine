# =============================================================================
# ChronosMatch Pro - Production Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in your merchant credentials.
# NEVER commit the actual '.env' or secret keys to version control.

# -----------------------------------------------------------------------------
# Official Razorpay Payment Gateway Credentials
# -----------------------------------------------------------------------------
# Obtain your API keys from Razorpay Dashboard -> Account & Settings -> API Keys
# Test mode keys start with: rzp_test_
# Live mode keys start with: rzp_live_
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Webhook Secret configured in Razorpay Dashboard -> Settings -> Webhooks
# Set for events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# -----------------------------------------------------------------------------
# Merchant Settlement Beneficiary (UPI / Bank)
# -----------------------------------------------------------------------------
MERCHANT_UPI_VPA=6305496537-4@ybl

# -----------------------------------------------------------------------------
# Application & Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///logs/margin_account.db
FRONTEND_URL=http://localhost:8000
SESSION_SECRET=chronos_super_secret_high_entropy_key_2026_change_in_prod

# -----------------------------------------------------------------------------
# High-Frequency Matching Engine Configuration
# -----------------------------------------------------------------------------
HFT_PORT=8000
HFT_RING_BUFFER_CAPACITY=131072
HFT_TARGET_OPS=100000
HFT_LOG_LEVEL=INFO
